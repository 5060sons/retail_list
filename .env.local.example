# Supabase 프로젝트 설정 (supabase.com > Project Settings > API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 관리자의 "직원 계정 생성" 기능에 필요 (절대 외부 노출 금지, 서버에서만 사용)
SUPABASE_SERVICE_ROLE_KEY=

# 아래 값들은 2단계(이메일/카카오톡 연동)에서 필요합니다. 지금은 비워둬도 됩니다.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NEXT_PUBLIC_KAKAO_JS_KEY=
